{
  "name": "video-transcriber",
  "private": true,
  "description": "Local single-user app: paste a video URL, download its audio with yt-dlp, and transcribe it with local Whisper models.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fernandoeeu/video-transcriber.git"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/node": "^22.20.1",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.3",
      "@libsql/client": "0.17.4",
      "libsql": "0.5.29",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev",
    "db:push": "vp run --filter @video-transcriber/db db:push",
    "db:studio": "vp run --filter @video-transcriber/db db:studio",
    "db:generate": "vp run --filter @video-transcriber/db db:generate",
    "db:migrate": "vp run --filter @video-transcriber/db db:migrate",
    "db:local": "vp run --filter @video-transcriber/db db:local"
  },
  "dependencies": {
    "@video-transcriber/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@video-transcriber/config": "workspace:*",
    "rolldown": "1.2.0",
    "typescript": "catalog:",
    "vite-plus": "0.2.6"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
  },
  "packageManager": "bun@1.3.14"
}

# libsql/SQLite URL. Copy this file to apps/web/.env (not the repo root).
# file:../../local.db resolves to the gitignored repo-root local.db when cwd is
# apps/web (Vite+ web scripts) or packages/db (drizzle-kit).
DATABASE_URL=file:../../local.db

# Origin URL required by packages/env/src/server.ts. Match the Vite port (3001).
CORS_ORIGIN=http://localhost:3001

# Optional. packages/env/src/server.ts defaults this to development.
# NODE_ENV=development
